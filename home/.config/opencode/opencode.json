{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "mcp": {},
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3-Coder"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "git show *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git status *": "allow",
      "git grep *": "allow",
      "git branch *": "allow",
      "git stash *": "allow",
      "git reflog *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "md5sum *": "allow",
      "sha256sum *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "xargs *": "allow"
    },
    "edit": "ask",
    "write": "ask"
  }
}
