# vim: ft=toml

theme = light:Seoulbones Light,dark:Catppuccin Macchiato
font-family = VictorMono Nerd Font
font-family-bold = VictorMono NFM Bold
font-family-italic = VictorMono NFM Oblique
font-family-bold-italic = VictorMono NFM Bold Oblique
# font-family = VictorMono Nerd Font Mono
# font-family = JetBrainsMono Nerd Font Mono
font-size = 13

font-thicken = true
# font-thicken-strength = 0-255
font-thicken-strength = 100

# ---------------------------------------------------------------------
# Look'n'feel
# ---------------------------------------------------------------------
window-colorspace = display-p3
window-show-tab-bar = always
macos-titlebar-style = tabs

window-padding-x = 14
window-padding-y = 14

background-opacity = 0.95
background-blur-radius = 15

custom-shader = ~/.config/ghostty/shaders/cursor_tail.glsl

# ---------------------------------------------------------------------
# OS/Shell integration
# ---------------------------------------------------------------------
notify-on-command-finish-action = no-bell,notify
shell-integration = zsh

# ---------------------------------------------------------------------
# Keybindings
# ---------------------------------------------------------------------
macos-option-as-alt = true

keybind = global:cmd+backquote=toggle_quick_terminal
keybind = opt+enter=toggle_split_zoom

# Move between panes
# The defaults are cmd+opt+arrows
# Alternatively there are the cmd+[ and cmd+] to sequence through the splits

# Outside Neovim.
keybind = performable:opt+h=goto_split:left
keybind = performable:opt+j=goto_split:down
keybind = performable:opt+k=goto_split:up
keybind = performable:opt+l=goto_split:right

# Inside Neovim.
keybind = nvim/
keybind = nvim/opt+h=esc:h
keybind = nvim/opt+j=esc:j
keybind = nvim/opt+k=esc:k
keybind = nvim/opt+l=esc:l
