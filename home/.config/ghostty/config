# vim: ft=toml

theme = light:Seoulbones Light,dark:Catppuccin Macchiato
font-family = VictorMono Nerd Font Propo
# font-family = VictorMono Nerd Font Mono
# font-family = JetBrainsMono Nerd Font Mono
font-size = 13

font-thicken = true
# font-thicken-strength = 0-255
font-thicken-strength = 100

# ---------------------------------------------------------------------
# Look'n'feel
# ---------------------------------------------------------------------
window-colorspace = display-p3
window-show-tab-bar = always
macos-titlebar-style = tabs

window-padding-x = 14
window-padding-y = 14

background-opacity = 0.95
background-blur-radius = 15

custom-shader = ~/.config/ghostty/shaders/cursor_tail.glsl

# ---------------------------------------------------------------------
# OS/Shell integration
# ---------------------------------------------------------------------
notify-on-command-finish-action = no-bell,notify
shell-integration = zsh

# ---------------------------------------------------------------------
# Keybindings
# ---------------------------------------------------------------------
macos-option-as-alt = true

# Move between panes
# The defaults are cmd+opt+arrows
# Alternatively there are the cmd+[ and cmd+] to sequence through the splits
keybind = opt+k=goto_split:top
keybind = opt+j=goto_split:bottom
keybind = opt+h=goto_split:left
keybind = opt+l=goto_split:right

keybind = super+control+shift+alt+arrow_down=resize_split:down,50
keybind = super+control+shift+alt+arrow_up=resize_split:up,50
keybind = super+control+shift+alt+arrow_left=resize_split:left,50
keybind = super+control+shift+alt+arrow_right=resize_split:right,50

keybind = opt+enter=toggle_split_zoom
