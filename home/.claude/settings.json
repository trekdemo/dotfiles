{
  "env": {},
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(bundle:*)",
      "Bash(bin/rails:*)",
      "Bash(bin/restart)",
      "Bash(bin/rspec:*)",
      "Bash(bin/rubocop:*)",
      "mcp__ide__getDiagnostics"
    ],
    "deny": []
  },
  "model": "opus",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "~/bin/claude-statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium"
}
