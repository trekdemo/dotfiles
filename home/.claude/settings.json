{
  "env": {},
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(tree:*)",
      "Bash(git add:*)",
      "Bash(git log:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(bundle install:*)",
      "Bash(bundle show:*)",
      "Bash(bin/rails:*)",
      "Bash(bin/restart)",
      "Bash(bin/rspec:*)",
      "Bash(bin/rubocop:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "deny": []
  },
  "model": "opus[1m]",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "~/bin/claude-statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium"
}
